{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "scraper",
  "title": "Stash Scraper",
  "description": "A stash scraper config. Generated from stash v0.31.1.",
  "type": "object",
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "debug": {
      "description": "Scraper debugging options",
      "allOf": [
        {
          "$ref": "#/definitions/debugOptions"
        }
      ]
    },
    "driver": {
      "description": "Scraping driver options",
      "allOf": [
        {
          "$ref": "#/definitions/driverOptions"
        }
      ]
    },
    "galleryByFragment": {
      "description": "Configuration for querying gallery by a Gallery fragment",
      "allOf": [
        {
          "$ref": "#/definitions/byFragment"
        },
        {
          "type": "object",
          "properties": {
            "queryURLReplace": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "checksum",
                  "filename",
                  "title",
                  "url"
                ]
              }
            }
          }
        }
      ]
    },
    "galleryByURL": {
      "description": "Configuration for querying a gallery by a URL",
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/byURL"
          },
          {
            "type": "object",
            "properties": {
              "queryURLReplace": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "url"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "groupByURL": {
      "description": "Configuration for querying a group by a URL",
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/byURL"
          },
          {
            "type": "object",
            "properties": {
              "queryURLReplace": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "url"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "imageByFragment": {
      "description": "Configuration for querying image by an Image fragment",
      "allOf": [
        {
          "$ref": "#/definitions/byFragment"
        },
        {
          "type": "object",
          "properties": {
            "queryURLReplace": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "checksum",
                  "filename",
                  "title",
                  "url"
                ]
              }
            }
          }
        }
      ]
    },
    "imageByURL": {
      "description": "Configuration for querying an image by a URL",
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/byURL"
          },
          {
            "type": "object",
            "properties": {
              "queryURLReplace": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "url"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "jsonScrapers": {
      "title": "JSON scrapers",
      "description": "Json scraping configurations",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\w+$": {
          "$ref": "#/definitions/scraper"
        }
      }
    },
    "movieByURL": {
      "description": "Deprecated: use groupByURL instead.",
      "deprecated": true,
      "deprecationMessage": "Deprecated: use groupByURL instead.",
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/byURL"
          },
          {
            "type": "object",
            "properties": {
              "queryURLReplace": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "url"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "name": {
      "title": "Scraper Name",
      "description": "The name of the scraper, as displayed in the Stash UI.",
      "type": "string"
    },
    "performerByFragment": {
      "description": "Configuration for querying performers by a Performer fragment",
      "allOf": [
        {
          "$ref": "#/definitions/byFragment"
        }
      ]
    },
    "performerByName": {
      "description": "Configuration for querying performers by name",
      "allOf": [
        {
          "$ref": "#/definitions/byName"
        }
      ]
    },
    "performerByURL": {
      "description": "Configuration for querying a performer by a URL",
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/byURL"
          },
          {
            "type": "object",
            "properties": {
              "queryURLReplace": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "url"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "sceneByFragment": {
      "description": "Configuration for querying scenes by a Scene fragment",
      "allOf": [
        {
          "$ref": "#/definitions/byFragment"
        },
        {
          "type": "object",
          "properties": {
            "queryURLReplace": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "checksum",
                  "filename",
                  "oshash",
                  "phash",
                  "title",
                  "url"
                ]
              }
            }
          }
        }
      ]
    },
    "sceneByName": {
      "description": "Configuration for querying scenes by name",
      "allOf": [
        {
          "$ref": "#/definitions/byName"
        }
      ]
    },
    "sceneByQueryFragment": {
      "description": "Configuration for querying scenes by query fragment",
      "allOf": [
        {
          "$ref": "#/definitions/byFragment"
        },
        {
          "type": "object",
          "properties": {
            "queryURLReplace": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "code",
                  "date",
                  "details",
                  "director",
                  "remote_site_id",
                  "title",
                  "url"
                ]
              }
            }
          }
        }
      ]
    },
    "sceneByURL": {
      "description": "Configuration for querying a scene by a URL",
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/definitions/byURL"
          },
          {
            "type": "object",
            "properties": {
              "queryURLReplace": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "url"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "stashServer": {
      "description": "Stash server configuration",
      "allOf": [
        {
          "$ref": "#/definitions/stashServer"
        }
      ]
    },
    "xPathScrapers": {
      "title": "XPath scrapers",
      "description": "Xpath scraping configurations",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^\\w+$": {
          "$ref": "#/definitions/scraper"
        }
      }
    }
  },
  "definitions": {
    "action": {
      "title": "Action",
      "description": "The scrape method to use.",
      "type": "string",
      "enum": [
        "scrapeJson",
        "scrapeXPath",
        "script",
        "stash"
      ]
    },
    "byFragment": {
      "type": "object",
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/definitions/action"
        },
        "queryURL": {
          "title": "Query URL",
          "description": "The URL to fetch, built from the fragment's placeholders.",
          "type": "string"
        },
        "queryURLReplace": {
          "title": "Query URL replacements",
          "description": "Regular expression replacements applied to the query URL placeholders before the request is made.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/replaceKey"
          }
        },
        "scraper": {
          "title": "Scraper definition name",
          "description": "The name of a configuration under xPathScrapers or jsonScrapers, matching the chosen action.",
          "type": "string"
        },
        "script": {
          "title": "Script",
          "description": "An executable and its arguments, run to perform the scrape.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "scrapeXPath",
                  "scrapeJson"
                ]
              }
            }
          },
          "then": {
            "required": [
              "scraper",
              "queryURL"
            ],
            "properties": {
              "queryURL": {
                "type": "string"
              },
              "scraper": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": [
              "script"
            ],
            "properties": {
              "script": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "byName": {
      "type": "object",
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/definitions/action"
        },
        "queryURL": {
          "title": "Query URL",
          "description": "The URL to fetch. The search term is substituted for the {} placeholder.",
          "type": "string"
        },
        "scraper": {
          "title": "Scraper definition name",
          "description": "The name of a configuration under xPathScrapers or jsonScrapers, matching the chosen action.",
          "type": "string"
        },
        "script": {
          "title": "Script",
          "description": "An executable and its arguments, run to perform the scrape.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "scrapeXPath",
                  "scrapeJson"
                ]
              }
            }
          },
          "then": {
            "required": [
              "scraper",
              "queryURL"
            ],
            "properties": {
              "queryURL": {
                "type": "string"
              },
              "scraper": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": [
              "script"
            ],
            "properties": {
              "script": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "byURL": {
      "type": "object",
      "required": [
        "action",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/definitions/action"
        },
        "queryURL": {
          "title": "Query URL",
          "description": "The URL to fetch, in place of the matched URL. Supports the {url} placeholder.",
          "type": "string"
        },
        "queryURLReplace": {
          "title": "Query URL replacements",
          "description": "Regular expression replacements applied to the query URL placeholders before the request is made.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/replaceKey"
          }
        },
        "scraper": {
          "title": "Scraper definition name",
          "description": "The name of a configuration under xPathScrapers or jsonScrapers, matching the chosen action.",
          "type": "string"
        },
        "script": {
          "title": "Script",
          "description": "An executable and its arguments, run to perform the scrape.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "url": {
          "title": "URLs",
          "description": "Partial URLs this configuration applies to. Matching is a substring test, so keep these loose enough to also match archived copies of the page.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "scrapeXPath",
                  "scrapeJson"
                ]
              }
            }
          },
          "then": {
            "required": [
              "scraper"
            ],
            "properties": {
              "scraper": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": [
              "script"
            ],
            "properties": {
              "script": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "clickOptions": {
      "type": "object",
      "required": [
        "xpath"
      ],
      "additionalProperties": false,
      "properties": {
        "sleep": {
          "title": "Sleep",
          "description": "Wait this many seconds after clicking, before continuing.",
          "type": "integer",
          "default": 2,
          "minimum": 1
        },
        "xpath": {
          "title": "Selector",
          "description": "XPath selector for the element to click.",
          "type": "string"
        }
      }
    },
    "commonSelectors": {
      "title": "Common selectors",
      "description": "Selector fragments that can be referenced by name in the selectors below.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^[$].+$": {
          "title": "Selector fragment",
          "type": "string"
        }
      }
    },
    "cookie": {
      "type": "object",
      "required": [
        "Domain",
        "Path",
        "Name"
      ],
      "additionalProperties": false,
      "properties": {
        "Domain": {
          "title": "Cookie domain",
          "type": "string"
        },
        "Name": {
          "title": "Cookie name",
          "type": "string"
        },
        "Path": {
          "title": "Cookie path",
          "type": "string"
        },
        "Value": {
          "title": "Cookie value",
          "type": "string"
        },
        "ValueRandom": {
          "title": "Random value length",
          "description": "Generate a random string of this many characters as the cookie value.",
          "type": "integer",
          "minimum": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "ValueRandom"
          ],
          "properties": {
            "ValueRandom": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "required": [
            "Value"
          ],
          "properties": {
            "Value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "cookieOptions": {
      "type": "object",
      "required": [
        "Cookies"
      ],
      "additionalProperties": false,
      "properties": {
        "CookieURL": {
          "title": "URL to apply these cookies to",
          "description": "Required if `useCDP` is `false`.",
          "type": "string",
          "format": "uri"
        },
        "Cookies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/cookie"
          }
        }
      }
    },
    "debugOptions": {
      "title": "Debugging",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "printHTML": {
          "title": "Print HTML",
          "description": "Print the HTML/JSON received by the scraper to the log.",
          "type": "boolean"
        }
      }
    },
    "driverOptions": {
      "title": "Scraper driver options",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clicks": {
          "title": "Clicks",
          "description": "Mouse clicks to perform on the page before scraping it.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/clickOptions"
          }
        },
        "cookies": {
          "title": "Cookie options",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/cookieOptions"
          }
        },
        "headers": {
          "title": "Headers",
          "description": "Headers to add to scraper requests.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/header"
          }
        },
        "sleep": {
          "title": "Sleep",
          "description": "Wait this many seconds after the page loads, before scraping it.",
          "type": "integer",
          "default": 2,
          "minimum": 1
        },
        "useCDP": {
          "title": "Use Chrome DevTools Protocol (CDP)",
          "description": "Fetch the page through the browser configured in Stash, rather than with a plain HTTP request.",
          "type": "boolean"
        }
      }
    },
    "galleryObject": {
      "title": "Gallery",
      "type": "object",
      "required": [
        "Title"
      ],
      "additionalProperties": false,
      "properties": {
        "Code": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Date": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Details": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Performers": {
          "$ref": "#/definitions/performerObject"
        },
        "Photographer": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Studio": {
          "$ref": "#/definitions/studioObject"
        },
        "Tags": {
          "$ref": "#/definitions/tagsObject"
        },
        "Title": {
          "$ref": "#/definitions/nodeSelector"
        },
        "URL": {
          "description": "Deprecated: use URLs instead.",
          "deprecated": true,
          "deprecationMessage": "Deprecated: use URLs instead.",
          "allOf": [
            {
              "$ref": "#/definitions/nodeSelector"
            }
          ]
        },
        "URLs": {
          "$ref": "#/definitions/nodeSelector"
        }
      }
    },
    "groupObject": {
      "title": "Group",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Aliases": {
          "$ref": "#/definitions/nodeSelector"
        },
        "BackImage": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Date": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Director": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Duration": {
          "$ref": "#/definitions/nodeSelector"
        },
        "FrontImage": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Name": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Studio": {
          "$ref": "#/definitions/studioObject"
        },
        "Synopsis": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Tags": {
          "$ref": "#/definitions/tagsObject"
        },
        "URL": {
          "description": "Deprecated: use URLs instead.",
          "deprecated": true,
          "deprecationMessage": "Deprecated: use URLs instead.",
          "allOf": [
            {
              "$ref": "#/definitions/nodeSelector"
            }
          ]
        },
        "URLs": {
          "$ref": "#/definitions/nodeSelector"
        }
      }
    },
    "header": {
      "type": "object",
      "required": [
        "Key",
        "Value"
      ],
      "additionalProperties": false,
      "properties": {
        "Key": {
          "title": "Key",
          "type": "string"
        },
        "Value": {
          "title": "Value",
          "description": "An empty value is a placeholder for a value the user is expected to fill in themselves, such as their own session cookie.",
          "type": "string"
        }
      }
    },
    "imageObject": {
      "title": "Image",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Code": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Date": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Details": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Performers": {
          "$ref": "#/definitions/performerObject"
        },
        "Photographer": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Studio": {
          "$ref": "#/definitions/studioObject"
        },
        "Tags": {
          "$ref": "#/definitions/tagsObject"
        },
        "Title": {
          "$ref": "#/definitions/nodeSelector"
        },
        "URLs": {
          "$ref": "#/definitions/nodeSelector"
        }
      }
    },
    "movieObject": {
      "title": "Movie",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Aliases": {
          "$ref": "#/definitions/nodeSelector"
        },
        "BackImage": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Date": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Director": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Duration": {
          "$ref": "#/definitions/nodeSelector"
        },
        "FrontImage": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Name": {
          "$ref": "#/definitions/nodeSelector"
        },
        "Synopsis": {
          "$ref": "#/definitions/nodeSelector"
        },
        "URLs": {
          "$ref": "#/definitions/nodeSelector"
        }
      }
    },
    "nodeSelector": {
      "title": "Selector",
      "oneOf": [
        {
          "title": "Simple selector",
          "type": [
            "string",
            "null"
          ]
        },
        {
          "title": "Fixed value",
          "type": "object",
          "required": [
            "fixed"
          ],
          "additionalProperties": false,
          "properties": {
            "fixed": {
              "title": "Fixed value",
              "description": "Use a literal value rather than scraping one. Post-processing is not applied to fixed values.",
              "type": "string"
            }
          }
        },
        {
          "title": "Complex selector",
          "allOf": [
            {
              "$ref": "#/definitions/nodeSelectorObject"
            },
            {
              "type": "object",
              "required": [
                "selector"
              ],
              "properties": {
                "selector": {
                  "type": "string"
                }
              },
              "not": {
                "type": "object",
                "required": [
                  "fixed"
                ],
                "properties": {
                  "fixed": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "nodeSelectorObject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concat": {
          "title": "Concatenate matches",
          "description": "Join every matched node into a single value, separated by this string.",
          "type": "string"
        },
        "fixed": {
          "type": "string"
        },
        "parseDate": {
          "description": "Deprecated: use a parseDate operation under postProcess instead.",
          "deprecated": true,
          "deprecationMessage": "Deprecated: use a parseDate operation under postProcess instead.",
          "type": "string"
        },
        "postProcess": {
          "title": "Post-processing operations",
          "description": "Alter the value with one or more operations, applied in the order they are given.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/postProcessAction"
          }
        },
        "replace": {
          "description": "Deprecated: use a replace operation under postProcess instead.",
          "deprecated": true,
          "deprecationMessage": "Deprecated: use a replace operation under postProcess instead.",
          "allOf": [
            {
              "$ref": "#/definitions/replaceKey"
            }
          ]
